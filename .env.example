ROBOFLOW_API_KEY=
ROBOFLOW_MODEL_ID=
ROBOFLOW_MODEL_VERSION=
ROBOFLOW_PEST_MODEL_ID=
ROBOFLOW_PEST_MODEL_VERSION=
WEATHER_API_KEY=
JWT_SECRET_KEY=replace-with-a-random-secret-of-at-least-32-bytes
DATABASE_URL=sqlite:///cropguard.db
ALLOWED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=
SUPABASE_STORAGE_BUCKET=crop-images
# Optional only when the backend must use a known working proxy. The backend
# does not inherit global HTTP_PROXY/HTTPS_PROXY settings for Supabase Auth.
SUPABASE_PROXY=
# Optional CA bundle path for managed TLS roots; certificate checks remain enabled.
SUPABASE_CA_BUNDLE=
WEATHER_CACHE_SECONDS=600
WEATHER_TIMEOUT_SECONDS=8
RATE_LIMIT_REQUESTS=120
RATE_LIMIT_WINDOW_SECONDS=60
# For Supabase production, DATABASE_URL must be replaced with the project's PostgreSQL URI.
# Keep SUPABASE_SECRET_KEY server-side. Never copy it into static JavaScript.
